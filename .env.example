# skopiuj do .env i uzupełnij
# baza musi istnieć: CREATE DATABASE filemenager;  (tabele tworzą się same)
# baza poza localhost (np. Neon) -> połączenie automatycznie szyfrowane SSL
DATABASE_URL=postgres://postgres:HASLO@localhost:5432/filemenager

# na serwerze (HTTPS): NODE_ENV=production -> ciasteczko sesji z flagą Secure, AUTH_SECRET wymagany
# lokalnie zostaw puste
NODE_ENV=

# klucz do podpisywania sesji - dowolny długi losowy ciąg, np. wynik:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
